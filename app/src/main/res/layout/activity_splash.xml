<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainSplashLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_splash"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- App Logo: Adjusted to a reasonable size -->
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:src="@drawable/travel_logo1"
            android:contentDescription="@string/logo_desc"
            android:scaleType="fitCenter" />

        <!-- App Name -->
        <TextView
            android:id="@+id/textViewAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textColor="@color/primary_accent"
            android:textSize="44sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/textViewTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/secondary_accent"
            android:textSize="20sp"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</RelativeLayout>